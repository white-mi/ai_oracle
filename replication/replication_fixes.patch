diff --git a/src/retrieval/keys.py b/src/retrieval/keys.py
new file mode 100644
index 0000000..86b6791
--- /dev/null
+++ b/src/retrieval/keys.py
@@ -0,0 +1,28 @@
+"""Evidence cache keys and packet checks for the replication.
+
+The original scripts keyed the cache by row_uid, which contains the row number of the input file.
+Architectures A and B were run with different row numbering, so 315 of 1,153 shared questions were
+retrieved separately and the two architectures read different packets. The key below depends only on
+the question itself, so every run and every architecture reads the same packet.
+"""
+import hashlib
+
+
+def evidence_cache_key(retrieval_mode: str, question) -> str:
+    digest = hashlib.sha1(
+        "\x1f".join([str(question.id), " ".join(str(question.question).split()),
+                     " ".join(str(question.description).split())]).encode("utf-8")
+    ).hexdigest()[:12]
+    return f"{retrieval_mode}__q_{question.id}_{digest}"
+
+
+def assert_packet_has_content(evidence, min_share: float = 0.8) -> None:
+    """Fail loudly if most sources carry no text (titles-only evidence)."""
+    sources = list(getattr(evidence, "sources", []) or [])
+    if not sources:
+        return
+    with_text = sum(1 for s in sources if s.content_for_prompt().strip())
+    if with_text / len(sources) < min_share:
+        raise ValueError(
+            f"Evidence packet {evidence.question_id}: only {with_text} of {len(sources)} sources have text"
+        )
diff --git a/tests/test_replication_fixes.py b/tests/test_replication_fixes.py
new file mode 100644
index 0000000..fca4e27
--- /dev/null
+++ b/tests/test_replication_fixes.py
@@ -0,0 +1,59 @@
+"""Regression tests for the two critical bugs found in the audit."""
+from types import SimpleNamespace
+
+import pytest
+
+from src.resolution.debate.runner import MultiLLMDebateRunner
+from src.retrieval.evidence import Source
+from src.retrieval.keys import assert_packet_has_content, evidence_cache_key
+
+
+def _highlight_sources():
+    return [Source(title=f"T{i}", url=f"https://e{i}.com", highlights=[f"fact number {i} from the article"]) for i in range(3)]
+
+
+def test_debate_prompt_contains_highlights():
+    r = MultiLLMDebateRunner(agents=[])
+    txt = r._format_exa_sources(_highlight_sources())
+    assert "fact number 0 from the article" in txt
+
+
+def _published_format(sources):
+    """The formatter as released at f76754b (runner.py lines 309-322)."""
+    lines = []
+    for idx, source in enumerate(sources, start=1):
+        lines.append(f"--- Source {idx} ---")
+        lines.append(f"Title: {source.title}")
+        lines.append(f"URL: {source.url}")
+        if source.published_date:
+            lines.append(f"Published: {source.published_date}")
+        lines.append(source.text)
+        lines.append("")
+    return "\n".join(lines)
+
+
+def test_titles_mode_reproduces_published_runs():
+    r = MultiLLMDebateRunner(agents=[], evidence_render="titles")
+    srcs = _highlight_sources()
+    txt = r._format_exa_sources(srcs)
+    assert "fact number" not in txt and txt == _published_format(srcs)
+
+
+def test_text_mode_refuses_titles_only_packet():
+    r = MultiLLMDebateRunner(agents=[])
+    with pytest.raises(ValueError):
+        r._format_exa_sources([Source(title="T", url="https://e.com")])
+
+
+def test_cache_key_does_not_depend_on_row_number():
+    q = SimpleNamespace(id="KXABC", question="Will  X happen?", description="Rule  text")
+    q2 = SimpleNamespace(id="KXABC", question="Will X happen?", description="Rule text")
+    q3 = SimpleNamespace(id="KXABC", question="Will X happen?", description="Other rule")
+    assert evidence_cache_key("highlights", q) == evidence_cache_key("highlights", q2)
+    assert evidence_cache_key("highlights", q) != evidence_cache_key("highlights", q3)
+
+
+def test_packet_without_text_is_rejected():
+    pk = SimpleNamespace(question_id="X", sources=[Source(title="T", url="https://e.com")] * 5)
+    with pytest.raises(ValueError):
+        assert_packet_has_content(pk)
